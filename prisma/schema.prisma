// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  sport     String?
  team      String?

  plays     Play[]
  roster    Player[]
  formations Formation[]

  favorites FavoritePlay[]

  sharedPlays PlayShare[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String
  expiresAt DateTime
  payload   Json
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Play {
  id          String   @id @default(cuid())
  title       String
  formation   String
  playType    String
  description String?

  grid        Json?

  // 👇 ownership
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])

  // 👇 sharing system
  isPublic    Boolean  @default(false)

  // 👇 optional collaboration later
  sharedWith  PlayShare[]

  favoritedBy FavoritePlay[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FavoritePlay {
  id      String @id @default(cuid())

  userId  String
  playId  String

  user    User   @relation(fields: [userId], references: [id])
  play    Play   @relation(fields: [playId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, playId])
}

model Player {
  id               String @id @default(cuid())
  firstName        String
  lastName         String
  playerNumber     Int?
  playerPositions  String // can upgrade later to Json array
  playerGrade      String?

  userId           String
  user             User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Formation {
  id            String @id @default(cuid())
  formationName String

  grid          Json?   // ⚠️ same concept as Play.grid

  ownerId       String
  owner         User   @relation(fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlayShare {
  id      String @id @default(cuid())

  playId  String
  userId  String

  play    Play   @relation(fields: [playId], references: [id])
  user    User   @relation(fields: [userId], references: [id])

  permission String @default("view") 
  // view | edit (future upgrade)

  createdAt DateTime @default(now())

  @@unique([playId, userId])
}