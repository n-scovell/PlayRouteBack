generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String         @id @default(cuid())
  email       String         @unique
  password    String
  name        String?
  sport       String?
  team        String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  favorites   FavoritePlay[]
  formations  Formation[]
  plays       Play[]
  sharedPlays PlayShare[]
  roster      Player[]
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String
  expiresAt DateTime
  payload   Json
  createdAt DateTime @default(now())
  used      Boolean  @default(false)
}

model Play {
  id          String         @id @default(cuid())
  title       String
  formation   String
  playType    String
  description String?
  grid        Json?
  ownerId     String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  isPublic    Boolean        @default(false)
  favoritedBy FavoritePlay[]
  owner       User           @relation(fields: [ownerId], references: [id])
  sharedWith  PlayShare[]
}

model FavoritePlay {
  id String @id @default(cuid())

  userId String
  playId String

  user User @relation(fields: [userId], references: [id])
  play Play @relation(fields: [playId], references: [id])

  notes FavoritePlayNote[]

  createdAt DateTime @default(now())

  @@unique([userId, playId])
}

model FavoritePlayNote {
  id String @id @default(cuid())

  favoritePlayId String
  favoritePlay   FavoritePlay @relation(fields: [favoritePlayId], references: [id], onDelete: Cascade)

  note String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Player {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  playerNumber    Int?
  playerPositions String
  playerGrade     String?
  userId          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
}

model Formation {
  id            String   @id @default(cuid())
  formationName String
  grid          Json?
  ownerId       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  owner         User     @relation(fields: [ownerId], references: [id])
}

model PlayShare {
  id         String   @id @default(cuid())
  playId     String
  userId     String
  permission String   @default("view")
  createdAt  DateTime @default(now())
  play       Play     @relation(fields: [playId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([playId, userId])
}
