generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String         @id @default(cuid())
  email       String         @unique
  password    String
  name        String?
  sport       String?
  team        String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  favorites   FavoritePlay[]
  formations  Formation[]
  plays       Play[]
  sharedPlays PlayShare[]
  roster      Player[]
  userBadges  UserBadge[]
}

model Guest {
  id                String          @id @default(cuid())
  name              String?
  email             String
  description       String?
  createdAt         DateTime        @default(now())
  guestExpiresAt    DateTime

  plays             GuestPlay[]
  formations        GuestFormation[]
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String
  expiresAt DateTime
  payload   Json
  createdAt DateTime @default(now())
  used      Boolean  @default(false)
}

model Play {
  id          String         @id @default(cuid())
  title       String
  formation   String
  playType    String
  description String?
  grid        Json?
  ownerId     String
  pursuit     Pursuit        @default(offense)
  favored     Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  isPublic    Boolean        @default(false)
  favoritedBy FavoritePlay[]
  owner       User           @relation(fields: [ownerId], references: [id])
  sharedWith  PlayShare[]
}

model GuestPlay {
  id          String   @id @default(cuid())
  title       String
  formation   String
  playType    String
  description String?
  grid        Json?

  guestId     String
  guest       Guest   @relation(fields: [guestId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}



model FavoritePlay {
  id String @id @default(cuid())

  userId String
  playId String

  user User @relation(fields: [userId], references: [id])
  play Play @relation(fields: [playId], references: [id])

  notes FavoritePlayNote[]

  createdAt DateTime @default(now())

  @@unique([userId, playId])
}

model FavoritePlayNote {
  id String @id @default(cuid())

  favoritePlayId String
  favoritePlay   FavoritePlay @relation(fields: [favoritePlayId], references: [id], onDelete: Cascade)

  note String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Player {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  playerNumber    Int?
  playerPositions String
  playerGrade     String?
  userId          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
}

model Formation {
  id            String   @id @default(cuid())
  formationName String
  grid          Json?
  pursuit       Pursuit  @default(offense)
  ownerId       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  owner         User     @relation(fields: [ownerId], references: [id])
}

model GuestFormation {
  id            String   @id @default(cuid())
  formationName String
  grid          Json?

  guestId       String
  guest         Guest   @relation(fields: [guestId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PlayShare {
  id         String   @id @default(cuid())
  playId     String
  userId     String
  permission String   @default("view")
  createdAt  DateTime @default(now())
  play       Play     @relation(fields: [playId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([playId, userId])
}


model Badge {
  id                  String  @id @default(cuid())
  name                String
  description         String
  icon                String
  category            BadgeCategory
  tier                BadgeTier
  hidden              Boolean @default(false)
  displayOrder        Int @default(0)
  requirementType     RequirementType
  requirementValue    Int?
  userBadges          UserBadge[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model UserBadge {
  id          String   @id @default(cuid())
  userId      String
  badgeId     String
  earnedAt    DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge       Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

enum RequirementType {
  PLAY_COUNT
  FORMATION_COUNT
  FAVORITE_COUNT
  SHARE_COUNT
  LOGIN_COUNT
}
enum BadgeCategory {
  PLAY
  FORMATION
  FAVORITE
  SHARE
  ACCOUNT
  ROSTER
}
enum BadgeTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

enum Pursuit {
  offense
  defense
}